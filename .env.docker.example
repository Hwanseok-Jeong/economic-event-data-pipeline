# Compose automatically loads .env; do not commit the filled-in file.
# Change these demo passwords before using a remote server.
MYSQL_DATABASE=market_events_demo
MYSQL_USER=pipeline
MYSQL_PASSWORD=local-demo-only
MYSQL_ROOT_PASSWORD=local-root-demo-only
DASHBOARD_PORT=8501
# Optional real-study overlay (always use a separate Compose project).
REAL_INPUT_DIR=./data/container-input
EVENT_TIMEZONE=UTC
STUDY_START=2024-10-08
STUDY_END=2024-12-30
